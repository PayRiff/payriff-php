{
    "name": "payriff/payriff-php",
    "description": "PHP client for the Payriff merchant API",
    "type": "library",
    "license": "MIT",
    "keywords": ["payriff", "payments", "azerbaijan"],
    "homepage": "https://github.com/payriff/payriff-php",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "phpseclib/phpseclib": "^3.0.36"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Payriff\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Payriff\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}